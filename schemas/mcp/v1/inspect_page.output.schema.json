{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typeanvil.com/schemas/mcp/v1/inspect_page.output.schema.json",
  "title": "inspect_page — output",
  "type": "object",
  "required": ["environment", "page", "page_count", "page_size", "boxes", "truncated"],
  "properties": {
    "environment": { "$ref": "common.schema.json#/$defs/Environment" },
    "page": { "type": "integer", "minimum": 1 },
    "page_count": { "type": "integer", "minimum": 1 },
    "page_size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "number" }, "height": { "type": "number" } },
      "additionalProperties": false
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "rect"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["block", "line", "text", "image", "table", "table-cell", "margin-box", "background", "border", "other"] },
          "element": { "type": "string", "description": "Tag name, with #id and .classes when present." },
          "dom_path": { "type": "string" },
          "rect": { "$ref": "common.schema.json#/$defs/Rect" },
          "text": { "type": "string" },
          "continued_from_previous_page": { "type": "boolean" },
          "continues_on_next_page": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "truncated": { "type": "boolean" },
    "image": {
      "type": "object",
      "required": ["media_type", "data_base64", "width_px", "height_px", "dpi"],
      "properties": {
        "media_type": { "const": "image/png" },
        "data_base64": { "type": "string", "contentEncoding": "base64" },
        "width_px": { "type": "integer" },
        "height_px": { "type": "integer" },
        "dpi": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
