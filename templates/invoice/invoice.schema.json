{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typeanvil.com/templates/invoice.schema.json",
  "title": "Invoice data",
  "type": "object",
  "required": ["number", "issue_date", "due_date", "currency", "seller", "buyer", "items"],
  "additionalProperties": false,
  "properties": {
    "number": { "type": "string", "minLength": 1, "maxLength": 40 },
    "issue_date": { "type": "string", "minLength": 1, "description": "ISO 8601 date, e.g. 2026-10-25" },
    "due_date": { "type": "string", "minLength": 1 },
    "currency": { "type": "string", "minLength": 1, "maxLength": 4 },
    "language": { "type": "string" },
    "tax_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction, e.g. 0.2 for 20%" },
    "notes": { "type": "string" },
    "seller": { "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "array", "items": { "type": "string" } }
      } },
    "buyer": { "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "array", "items": { "type": "string" } }
      } },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unit_price"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "minimum": 0 },
          "unit_price": { "type": "number" }
        }
      }
    }
  }
}
